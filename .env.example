# U.E. Paulo Freire - Configuración de Entorno
# Copiar este archivo a .env y ajustar los valores según el entorno

# Entorno de ejecución (local, staging, production)
APP_ENV=local

# Base de datos
DB_HOST=127.0.0.1
DB_NAME=ue_paulo_freire
DB_USER=root
DB_PASS=

# Aplicación
APP_NAME="U.E. Paulo Freire"
APP_URL=http://localhost/ue_paulo_freire_web
APP_VERSION=5.0

# Correo electrónico
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-responder@uepaulofreire.edu.bo
MAIL_FROM_NAME="U.E. Paulo Freire"

# Zona horaria
APP_TIMEZONE=America/La_Paz
